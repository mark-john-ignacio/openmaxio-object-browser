# Example environment variables for docker-compose and Coolify

# OpenMaxIO Console (UI) secrets for JWT encryption
CONSOLE_PBKDF_PASSPHRASE=please-change-passphrase
CONSOLE_PBKDF_SALT=please-change-salt

# MinIO bootstrap credentials
MINIO_ROOT_USER=console
MINIO_ROOT_PASSWORD=consoleconsole

# Host port mappings (change to avoid 'already allocated' errors)
# Change these if 8080/9000/9001 are in use on your machine/server
APP_PORT=8080
MINIO_S3_PORT=9000
MINIO_CONSOLE_PORT=9001

# Optional: override the internal MinIO endpoint used by the UI
# CONSOLE_MINIO_SERVER=http://minio:9000

# Public URL settings for MinIO (used for presigned links/redirects behind a proxy)
# Set to your external S3 endpoint, e.g. https://s3.example.com
MINIO_SERVER_URL=
# Optional: enable virtual-hosted-style (bucket.s3.example.com). Requires DNS wildcard.
MINIO_DOMAIN=
